# Copy to .env. Local values below match compose.yaml (local-only credentials, not secrets).
DATABASE_URL=postgresql://tenantdesk:tenantdesk@localhost:5433/tenantdesk
# Prisma CLI (migrations) uses the direct URL; on Vercel/Neon it's the unpooled endpoint.
DATABASE_URL_UNPOOLED=postgresql://tenantdesk:tenantdesk@localhost:5433/tenantdesk
# Test suites only — must point at a database whose name ends in _test.
TEST_DATABASE_URL=postgresql://tenantdesk:tenantdesk@localhost:5433/tenantdesk_test

# openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Chosen by you, never committed; used by the seed and the test suites.
SEED_USER_PASSWORD=
